{
  "name": "What-if Report (cooffice)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "Web (Vite)" },
    "3001": { "label": "API (Fastify)" }
  },
  "postCreateCommand": "node scripts/setup.mjs --full",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
