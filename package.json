{
  "name": "what-if-report",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "example:generate": "node scripts/create-example.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:test": "npm --prefix server test",
    "server:migrate": "npm --prefix server run migrate",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm:server:dev\" \"npm:dev\"",
    "verify": "npm run typecheck && npm test && npm run test:e2e && npm run build && npm run server:test && npm run server:build",
    "test:e2e:full": "playwright test --config=playwright.fullstack.config.ts",
    "smoke": "npm run server:build && cd server && bash scripts/smoke.sh"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
