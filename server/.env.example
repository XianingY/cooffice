# Server runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Security (CHANGE these in production; use long random values)
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Database
DATABASE_PATH=./data/whatif.db

# CORS: comma-separated explicit origins, no wildcard in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Static frontend (optional; when set, server also serves the built SPA)
SERVE_STATIC=false
STATIC_DIR=../dist
