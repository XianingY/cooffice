{
  "name": "what-if-report-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Desktop shell for What-if Report: a local-first what-if analysis workbench",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "build": "tsc -p tsconfig.build.json",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/package.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.10.5",
    "electron": "^36.9.5",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.3",
    "vitest": "^3.0.7"
  }
}
